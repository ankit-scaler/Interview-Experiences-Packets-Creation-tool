# ---------------------------------------------------------------------------
# Database — Neon Postgres (free tier). Create a project at neon.tech.
# DATABASE_URL = pooled connection string ("-pooler" host).
# DIRECT_URL   = direct (non-pooled) connection string — used for migrations.
# ---------------------------------------------------------------------------
# Pooled URL: add `pgbouncer=true` (Prisma + Neon pooler) and a longer connect
# timeout so the first query after Neon auto-suspends doesn't error out.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ---------------------------------------------------------------------------
# Auth.js — Google OAuth
# AUTH_SECRET: run `openssl rand -base64 33`
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console → Credentials → OAuth client (Web)
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Public base URL. On Vercel you can leave AUTH_URL and NEXT_PUBLIC_APP_URL unset —
# Auth.js infers the host (trustHost) and the app falls back to Vercel's injected
# VERCEL_PROJECT_PRODUCTION_URL. Set NEXT_PUBLIC_APP_URL only for a custom domain.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OpenRouter — all model calls go through here (OpenAI-compatible gateway).
# Key: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Model for web research + JD spillover (higher quality)
LLM_MODEL="anthropic/claude-sonnet-5"
# Model for readability / round naming / dedupe tie-breaks / link lookup (cheap)
LLM_MODEL_CHEAP="anthropic/claude-haiku-4.5"
# Abort a generation run if cost exceeds this (USD), unless the admin ticked
# "allow higher cost" on the create form.
MAX_PACKET_COST_USD="0.50"
# Web search is an OpenRouter plugin, billed per request (~$0.007 on Exa).
WEB_SEARCH_ENGINE="exa"
WEB_SEARCH_MAX_RESULTS="5"
LINK_SEARCH_MAX_RESULTS="5"
LINK_LOOKUP_MAX_QUESTIONS="12"

# ---------------------------------------------------------------------------
# Google Sheets — service account (Google Cloud Console → IAM → Service Accounts
# → create key (JSON)). Share:
#   • question repo sheet  → Viewer
#   • tracking sheet       → Editor
# Paste the private key with literal \n escapes, wrapped in double quotes.
# ---------------------------------------------------------------------------
GOOGLE_SA_EMAIL=""
# Recommended: run  node scripts/encode-sa-key.mjs <key.json>  and paste its output.
GOOGLE_SA_PRIVATE_KEY_BASE64=""
# Raw-key alternative (must be the complete key, with \n escapes, in quotes):
GOOGLE_SA_PRIVATE_KEY=""
REPO_SHEET_ID="10jyG2WkaTRtBTwm0lLQWogLibqLU6qAGr5OhKh9xcoE"
TRACKING_SHEET_ID="1OT9Xr2W87LAj-PT87P0Mj9J1uuRRWQB9dVaH57xFZ9Y"

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
ADMIN_EMAIL_DOMAIN="scaler.com"
CONTACT_EMAIL="ankit.mishra@scaler.com"
# Secret guarding the Vercel Cron sync endpoint. `openssl rand -hex 16`
CRON_SECRET=""
